# VAULTIA ESCROW — Variables d'environnement
# Renommez en .env

# 1. Token du bot Telegram (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# 2. Votre Telegram ID (pour recevoir les alertes litige)
# Obtenez-le en écrivant à @userinfobot
ADMIN_TELEGRAM_ID=

# 3. Supabase (supabase.com → Settings → API)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=     # service_role key

# 4. NotchPay (notchpay.co → Settings → Developer)
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=

# 5. URL publique (Railway après déploiement)
WEBHOOK_BASE_URL=https://votre-app.railway.app

# Sans NOTCHPAY_PUBLIC_KEY → mode simulation automatique
